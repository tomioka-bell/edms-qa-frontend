# คัดลอกเป็น .env.local แล้วแก้ตามต้องการ

# local   = รันเดี่ยว login ที่ portal (VITE_PORTAL_URL) — QA ไม่มีหน้า login ของตัวเอง (ค่าเริ่มต้น)
# gateway = ใช้ login จริงของ auth-web — ต้องรัน auth-web (:5173) + auth backend (:8000) และเปิดผ่าน :5173/qa/
# (build production จะใช้ gateway เสมอ)
VITE_AUTH_MODE=local

# auth-web (gateway) — ใช้เฉพาะโหมด gateway
VITE_GATEWAY_URL=http://10.144.1.98:7744

# backend (Go Fiber) ที่ dev server ส่งต่อ /api ไปให้ — ใช้ได้แค่ใน vite.config.ts
API_PROXY_TARGET=http://localhost:7072

# หน้า login ของ portal — โหมด local: ยังไม่ login / session หมดอายุ / กด Sign out จะพาไปที่ {VITE_PORTAL_URL}/login
VITE_PORTAL_URL=http://localhost:5175
